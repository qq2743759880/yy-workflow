  "edges": [
    {
      "id": "initial-goals",
      "from": "init",
      "to": "requirements",
      "role": "main"
    },
    {
      "id": "signed-concept",
      "from": "requirements",
      "to": "research",
      "label": "概念签收",
      "role": "main"
    },
    {
      "id": "research-proof",
      "from": "research",
      "to": "tasks",
      "label": "真实来源",
      "role": "main"
    },
    {
      "id": "task-contract",
      "from": "tasks",
      "to": "contract",
      "role": "main"
    },
    {
      "id": "contract-admission",
      "from": "contract",
      "to": "admission",
      "role": "main"
    },
    {
      "id": "permit-execute",
      "from": "admission",
      "to": "execute",
      "label": "允许",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "execution-evidence",
      "from": "execute",
      "to": "accept",
      "label": "复验",
      "role": "main"
    },
    {
      "id": "denied-repair",
      "from": "admission",
      "to": "contract",
      "label": "拒绝：补前置",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel"
    },
    {
      "id": "acceptance-rework",
      "from": "accept",
      "to": "execute",
      "label": "未通过：返工后重验",
      "role": "return",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "七个入口，按顺序推进",
      "items": [
        "每次入口都先消费 Decision；状态记录不能代替许可。",
        "内部步骤映射：0 → 1 → 1.5 → 3 → 5 → 7 → 8。"
      ]
    },
    {
      "dot": "amber",
      "title": "发现问题，可以回跳",
      "items": [
        "内部 2 / 4 / 6 是回跳层，分别承接需求、拆分与契约修正。",
        "它们不是 /yy 命令编号；改动后复核受影响的前置与证据。"
      ]
    }
  ]
